# Địa chỉ backend — 05-API.md §2.1. Demo trong LAN thì đổi 127.0.0.1 thành IP của laptop.
# Dùng 127.0.0.1 chứ không dùng localhost: trình duyệt thử IPv6 ::1 trước, daphne chỉ nghe
# IPv4 → mỗi kết nối mới (kể cả WebSocket) chậm thêm ~220 ms (đo ngày 18/09/2026).
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/realtime/
VITE_USE_MOCK=false
