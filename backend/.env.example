# Chép file này thành `.env` rồi điền giá trị thật. `.env` KHÔNG được commit.

# ---------- Django ----------
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
DEBUG=True
# Demo trong LAN: thêm IP của laptop (05-API.md §2.9)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
DB_NAME=iot_room
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------- Redis (channel layer — bắt buộc, CLAUDE.md §5.1) ----------
# Số 5 ở cuối là số database của Redis, tách riêng khỏi dự án khác dùng chung Redis.
REDIS_URL=redis://localhost:6379/5

# ---------- MQTT broker (Mosquitto) ----------
# Dùng 127.0.0.1, KHÔNG dùng localhost: Windows thử IPv6 ::1 trước, Mosquitto chỉ nghe IPv4
# → mỗi lần kết nối mất thêm ~2 giây, POST .../control vượt ngưỡng 200 ms của NFR-01.
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
MQTT_USERNAME=iotuser
MQTT_PASSWORD=
# Giây — broker chết thì POST .../control trả 503 sau tối đa chừng này (NFR-01)
MQTT_CONNECT_TIMEOUT=2

